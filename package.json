{
  "name": "caricamento",
  "version": "0.1.0",
  "description": "CLI that builds, signs and publishes Android and iOS releases to Firebase App Distribution, Google Play and TestFlight in one command.",
  "keywords": [
    "cli",
    "mobile",
    "mobile-release",
    "release-automation",
    "continuous-delivery",
    "android",
    "ios",
    "react-native",
    "expo",
    "gradle",
    "xcode",
    "code-signing",
    "firebase",
    "firebase-app-distribution",
    "google-play",
    "play-console",
    "internal-app-sharing",
    "testflight",
    "app-store-connect",
    "fastlane-alternative"
  ],
  "homepage": "https://github.com/teivienn/caricamento#readme",
  "bugs": {
    "url": "https://github.com/teivienn/caricamento/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teivienn/caricamento.git"
  },
  "author": "teivienn <teivienn@gmail.com>",
  "license": "MIT",
  "type": "module",
  "bin": {
    "caricamento": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint ."
  },
  "dependencies": {
    "commander": "^15.0.0",
    "google-auth-library": "^11.1.0",
    "jiti": "^2.7.0",
    "jose": "^6.2.12",
    "ora": "^9.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "msw": "^2.15.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
